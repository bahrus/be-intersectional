{
  "name": "be-intersectional",
  "version": "0.0.77",
  "description": "be-intersectional provides a base class for be-decorated behaviors / decorators that behave according to visibility.",
  "main": "be-intersectional.js",
  "module": "be-intersectional.js",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "scripts": {
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "files": [
    "*.js",
    "./ts-refs/be-enhanced/*.*",
    "./ts-refs/be-intersectional/*.*"
  ],
  "exports": {
    ".": "./be-intersectional.js",
    "./be-intersectional.js": "./be-intersectional.js",
    "./isVisible.js": "./isVisible.js"
  },
  "types": "./ts-refs/be-intersectional/types.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-intersectional.git"
  },
  "dependencies": {
    "be-enhanced": "0.0.189",
    "trans-render": "0.0.960"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "spa-ssi": "0.0.23"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-intersectional/issues"
  },
  "homepage": "https://github.com/bahrus/be-intersectional#readme"
}
